{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FLISP Memory Image",
  "scopeName": "source.fmem",
  "patterns": [
    { "include": "#comment" },
    { "include": "#setmemory" },
    { "include": "#hex" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.fmem",
      "match": ";.*$"
    },
    "setmemory": {
      "match": "(?i)(#setMemory)[ \\t]+([0-9A-F]{1,2})[ \\t]*(=)[ \\t]*([0-9A-F]{1,2})",
      "captures": {
        "1": { "name": "keyword.other.directive.fmem" },
        "2": { "name": "constant.numeric.address.fmem" },
        "3": { "name": "keyword.operator.assignment.fmem" },
        "4": { "name": "constant.numeric.hex.fmem" }
      }
    },
    "hex": {
      "name": "constant.numeric.hex.fmem",
      "match": "(?<![A-Za-z0-9_])[0-9A-Fa-f]{2}(?![A-Za-z0-9_])"
    }
  }
}
