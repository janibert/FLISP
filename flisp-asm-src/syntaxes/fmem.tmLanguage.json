{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FLISP Memory Image",
  "scopeName": "source.fmem",
  "comment": "Format wie von qaflisp erzeugt: Kopfzeilen ohne '#', danach '# ClearAllMemory', '# ClearAllRegisters' und '#setMemory  AA=WW'.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#setmemory" },
    { "include": "#clear" },
    { "include": "#command" },
    { "include": "#header" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.fmem",
      "match": ";.*$"
    },
    "setmemory": {
      "match": "(?i)^[ \\t]*(#[ \\t]*setMemory)[ \\t]+([0-9A-F]{1,2})[ \\t]*(=)[ \\t]*([0-9A-F]{1,2})(?![0-9A-Za-z_])",
      "captures": {
        "1": { "name": "keyword.other.directive.fmem" },
        "2": { "name": "constant.numeric.address.fmem" },
        "3": { "name": "keyword.operator.assignment.fmem" },
        "4": { "name": "constant.numeric.hex.fmem" }
      }
    },
    "clear": {
      "comment": "'# ClearAllMemory' und '# ClearAllRegisters' setzen den Simulator zurueck - eigene Hervorhebung, getrennt von #setMemory.",
      "match": "(?i)^[ \\t]*(#[ \\t]*ClearAll(?:Memory|Registers))(?![A-Za-z0-9_])",
      "captures": {
        "1": { "name": "keyword.control.reset.fmem" }
      }
    },
    "command": {
      "comment": "Sonstige Kommandos, die mit '#' beginnen.",
      "match": "^[ \\t]*(#[ \\t]*[A-Za-z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.directive.fmem" }
      }
    },
    "header": {
      "comment": "Kopfzeilen von qaflisp (Versionsangabe, Dateiname) - alles, was nicht mit '#' beginnt.",
      "name": "comment.line.header.fmem",
      "match": "^(?![ \\t]*[#;])[ \\t]*\\S.*$"
    }
  }
}
