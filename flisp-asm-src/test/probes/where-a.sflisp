N           EQU     4
BASE        EQU     $10
MASK        EQU     1<<N-1
TOP         EQU     Table+N*2
            ORG     BASE*2
Start       LDA     #N*3+1
            LDA     #MASK%5
            LDA     #Table>>1
            LDA     #'A'+1
            LDA     Table+2
            STA     BASE+N
            LDA     N-1,X
            LDA     Table-Start,Y
            LDA     2*N,SP
            BRA     Loop+2
            BNE     Start+(Loop-Start)/2
Loop        JMP     Start+1
            JSR     Loop&$FE
            LDX     #Table+N
            LDSP    #$FF-N
            ANDCC   #~1
            ORCC    #1<<4
            BRA     *+2
Table       FCB     N,N*2,BASE|1,Table,Loop-Start,'Z'-'A'
            FCB     TOP
            RMB     N*2
            RMB     Later-Table
Later       FCS     "AB"
            ORG     Table+$20
            FCB     ~N&$FF
            END     Start+0
