; 6 - Ausdruecke
; qaflisp kennt nur zwei Vorrangstufen, beide von links nach rechts:
;   * / %   vor   + - & | ^ << >> && ||      (anders als in C!)
; Einstellig: - ~ !   Klammern ( )
;
; Ausprobieren:
;   - Hover ueber P1 ... P8: der Wert, den qaflisp ausrechnet.
;   - Mache aus den FEHLER-Zeilen korrekte Ausdruecke und beobachte,
;     wie die Meldung verschwindet.

P1          EQU     2<<1+1          ; OK: (2<<1)+1 = 5, in C waere es 8
P2          EQU     6&3+1           ; OK: (6&3)+1 = 3
P3          EQU     10-4/2          ; OK: 10-(4/2) = 8
P4          EQU     7%3             ; OK: Modulo = 1
P5          EQU     %11%%10         ; OK: 3 mod 2 = 1 (% nach Wert = Modulo)
P6          EQU     5&&3            ; OK: logisch UND = 1
P7          EQU     -7/2            ; OK: -3 (wie in C abgeschnitten)
P8          EQU     ~0&$F           ; OK: 15

            ORG     $20
            LDA     #(P1+1)*2       ; OK: 12
            LDA     #2*(3           ; FEHLER: Klammer nicht geschlossen
            LDA     #2*3)           ; FEHLER: Klammer ohne (
            LDA     #2**3           ; FEHLER: Operator ohne Wert davor
            LDA     #2+             ; FEHLER: Wert fehlt am Ende
            LDA     #2(3)           ; FEHLER: Operator fehlt
            FCB     1<2             ; FEHLER: kein Vergleich, Shift ist <<
            FCB     X+1             ; FEHLER: Registername im Ausdruck
            FCB     P1/0            ; FEHLER: Division durch 0
            FCB     P1%0            ; OK: qaflisp liefert 0
            FCB     (1,2)           ; FEHLER: Komma trennt immer FCB-Werte
            FCB     PC              ; FEHLER: PC ist ein normales (undefiniertes) Symbol
            BRA     *+2             ; FEHLER: es gibt keinen Adresszaehler *
            FCB     (2+)            ; WARNUNG: qaflisp nimmt still 0 fuer den fehlenden Wert
            FCB     1~2             ; WARNUNG: qaflisp verwirft die 1 still: ergibt ~2
