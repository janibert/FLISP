; 6 - Expressions
; qaflisp has only two precedence levels, both left to right:
;   * / %   before   + - & | ^ << >> && ||      (unlike C!)
; Unary: - ~ !   Parentheses ( )
;
; Try it:
;   - Hover over P1 ... P8: the value qaflisp computes.
;   - Turn the ERROR lines into correct expressions and watch the
;     message disappear.

P1          EQU     2<<1+1          ; OK: (2<<1)+1 = 5, in C it would be 8
P2          EQU     6&3+1           ; OK: (6&3)+1 = 3
P3          EQU     10-4/2          ; OK: 10-(4/2) = 8
P4          EQU     7%3             ; OK: modulo = 1
P5          EQU     %11%%10         ; OK: 3 mod 2 = 1 (% after a value = modulo)
P6          EQU     5&&3            ; OK: logical AND = 1
P7          EQU     -7/2            ; OK: -3 (truncated as in C)
P8          EQU     ~0&$F           ; OK: 15

            ORG     $20
            LDA     #(P1+1)*2       ; OK: 12
            LDA     #2*(3           ; ERROR: parenthesis not closed
            LDA     #2*3)           ; ERROR: parenthesis without (
            LDA     #2**3           ; ERROR: operator without a value before it
            LDA     #2+             ; ERROR: value missing at the end
            LDA     #2(3)           ; ERROR: operator missing
            FCB     1<2             ; ERROR: no comparison, the shift is <<
            FCB     X+1             ; ERROR: register name in an expression
            FCB     P1/0            ; ERROR: division by 0
            FCB     P1%0            ; OK: qaflisp gives 0
            FCB     (1,2)           ; ERROR: the comma always separates FCB values
            FCB     PC              ; ERROR: PC is an ordinary (undefined) symbol
            BRA     *+2             ; ERROR: there is no location counter *
            FCB     (2+)            ; WARNING: qaflisp silently uses 0 for the missing value
            FCB     1~2             ; WARNING: qaflisp silently drops the 1: gives ~2
