{
  "name": "flisp-asm",
  "displayName": "FLISP Assembly",
  "description": "Syntax highlighting and assembling (with the bundled qaflisp) for FLISP (FLexible Instruction Set Processor) assembly, as used with DigiFlisp.",
  "version": "0.8.0",
  "publisher": "janibert",
  "author": "Jan Ebert",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/janibert/FLISP.git",
    "directory": "flisp-asm-src"
  },
  "homepage": "https://github.com/janibert/FLISP/tree/main/flisp-asm-src#readme",
  "bugs": {
    "url": "https://github.com/janibert/FLISP/issues"
  },
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "flisp",
    "digiflisp",
    "qaflisp",
    "assembly",
    "assembler",
    "asm"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flisp",
    "onLanguage:fmem",
    "onCommand:flisp.assemble"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Assembling runs qaflisp and is disabled in untrusted workspaces.",
      "restrictedConfigurations": [
        "flisp.qaflispPath"
      ]
    }
  },
  "scripts": {
    "build:grammar": "node scripts/build-grammar.js",
    "test": "node scripts/build-grammar.js --check && node test/qaflisp-test.js && node test/symbols-test.js && node test/instructions-test.js && node test/fmem-test.js && node test/format-test.js && node test/completion-test.js && node test/tokenize-test.js",
    "vscode:prepublish": "node scripts/build-grammar.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "flisp",
        "aliases": [
          "FLISP Assembly",
          "flisp"
        ],
        "extensions": [
          ".sflisp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fmem",
        "aliases": [
          "FLISP Memory Image",
          "fmem"
        ],
        "extensions": [
          ".fmem"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flisp",
        "scopeName": "source.flisp",
        "path": "./syntaxes/flisp.tmLanguage.json"
      },
      {
        "language": "fmem",
        "scopeName": "source.fmem",
        "path": "./syntaxes/fmem.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.type.instruction.custom.flisp",
            "settings": {
              "fontStyle": "italic underline"
            }
          },
          {
            "scope": "support.type.directive.flisp",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.operator.immediate.flisp",
            "settings": {
              "fontStyle": "bold"
            }
          }
        ]
      },
      "[flisp]": {
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.guides.indentation": false,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      {
        "command": "flisp.assemble",
        "title": "Assemble",
        "category": "FLISP",
        "icon": "$(play)",
        "enablement": "resourceLangId == flisp"
      },
      {
        "command": "flisp.nextColumn",
        "title": "Move to next column",
        "category": "FLISP"
      },
      {
        "command": "flisp.previousColumn",
        "title": "Move to previous column",
        "category": "FLISP"
      },
      {
        "command": "flisp.acceptSuggestionAndNextColumn",
        "title": "Accept suggestion and move to next column",
        "category": "FLISP"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flisp.assemble",
          "when": "resourceLangId == flisp",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "flisp.assemble",
          "when": "resourceLangId == flisp",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "flisp.assemble",
          "when": "editorLangId == flisp"
        },
        {
          "command": "flisp.nextColumn",
          "when": "false"
        },
        {
          "command": "flisp.previousColumn",
          "when": "false"
        },
        {
          "command": "flisp.acceptSuggestionAndNextColumn",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "flisp.assemble",
        "key": "f7",
        "when": "editorLangId == flisp"
      },
      {
        "command": "flisp.nextColumn",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == flisp && !editorReadonly && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasSelection"
      },
      {
        "command": "flisp.previousColumn",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == flisp && !editorReadonly && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasSelection"
      },
      {
        "command": "flisp.acceptSuggestionAndNextColumn",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == flisp && suggestWidgetVisible && !inSnippetMode && !editorHasSelection"
      }
    ],
    "configuration": {
      "title": "FLISP",
      "properties": {
        "flisp.qaflispPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to qaflisp. If empty, it is searched for in the source file's folder and its parents up to the workspace folder, in the workspace folders, on the `PATH` and in the DigiFlisp installation folder; on Windows, the copy bundled with the extension is used last."
        },
        "flisp.assembleOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Assemble .sflisp files automatically when they are saved."
        },
        "flisp.listFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Create a list file (`.lst`) — qaflisp option `-L`."
        },
        "flisp.warnings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report warnings — qaflisp option `-w`."
        },
        "flisp.debugInfo": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Generate source-level debug information — qaflisp option `-g`."
        },
        "flisp.columns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            12,
            20,
            36
          ],
          "markdownDescription": "Start columns of mnemonic, operand and comment in `.sflisp` files (the label starts in column 0). Used by Tab / Shift+Tab and by *Format Document*."
        }
      }
    }
  }
}
